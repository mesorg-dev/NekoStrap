<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Без UseWindowsForms: System.Windows.Forms тянется из WindowsDesktop-пака
         по явному using-алиасу, а implicit-мпорт обоих наборов давал
         неоднозначности (Button/CheckBox/Application/...) по всему проекту. -->
    <AssemblyName>NekoStrap</AssemblyName>
    <RootNamespace>NekoStrap</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Встроенные шрифты (OFL, лицензии рядом). Фолбэк — системные,
         поэтому без файлов тоже собирается и работает. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <!-- Общая логика — отдельным проектом (раньше были линки на исходники) -->
  <ItemGroup>
    <ProjectReference Include="..\NekoStrap.Core\NekoStrap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Только для декода webp-обоев (WPF из коробки webp не умеет) -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <!-- Дымовой тест видит internal-классы окна -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NekoStrap.Smoke</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- MainWindow использует System.IO напрямую -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
