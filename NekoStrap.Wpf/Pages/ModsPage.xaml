<UserControl x:Class="NekoStrap.Wpf.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NekoStrap.Wpf">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="{l:L Nav_Mods}" Margin="0,0,0,6"/>
    <TextBlock Style="{StaticResource Body}" Text="{l:L Mods_Sub}" Margin="0,0,0,10"/>

    <!-- Профили модов: инстансы набора файлов, переключение в один клик -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L ModP_Title}" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Mono}" TextWrapping="Wrap" Text="{l:L ModP_Sub}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:L ModP_Active}" FontFamily="{DynamicResource UiFont}" FontSize="12.5"
                     Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ComboBox x:Name="ProfilesCombo" Style="{StaticResource DarkCombo}" Width="240"
                    SelectionChanged="ProfilesCombo_SelectionChanged"/>
          <TextBlock x:Name="ProfileStatus" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBox x:Name="ProfileNameBox" Style="{StaticResource DarkInput}" Width="220" Height="38"
                   VerticalContentAlignment="Center" ToolTip="{l:L ModP_NameTip}"/>
          <Button Style="{StaticResource PrimaryButton}" Content="{l:L ModP_New}" Height="38" Padding="16,0"
                  Margin="10,0,0,0" Click="ProfileNewButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L ModP_Dup}" Height="38" Padding="16,0"
                  Margin="10,0,0,0" Click="ProfileDupButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Delete}" Height="38" Padding="16,0"
                  Margin="10,0,0,0" Click="ProfileDeleteButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Folder}" Height="38" Padding="16,0"
                  Margin="10,0,0,0" Click="ProfileFolderButton_Click"/>
        </StackPanel>
        <!-- Авто-профиль: привязать этот набор к последней игре -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="{l:L AutoP_Label}" FontFamily="{DynamicResource UiFont}" FontSize="12.5"
                     Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L AutoP_Bind}" Height="34" Padding="14,0"
                  Click="ProfileBindButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L AutoP_Unbind}" Height="34" Padding="14,0"
                  Margin="8,0,0,0" Click="ProfileUnbindButton_Click"/>
          <TextBlock x:Name="ProfileBindStatus" Style="{StaticResource Mono}" VerticalAlignment="Center"
                     TextWrapping="Wrap" Margin="12,0,0,0"/>
        </StackPanel>
        <!-- Профиль → zip и обратно: поделиться набором -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Style="{StaticResource OutlineButton}" Content="{l:L ModP_Export}" Height="34" Padding="14,0"
                  Click="ProfileExportButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L ModP_Import}" Height="34" Padding="14,0"
                  Margin="10,0,0,0" Click="ProfileImportButton_Click"/>
          <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" VerticalAlignment="Center"
                     TextWrapping="Wrap" Margin="12,0,0,0" Text="{l:L ModP_IoHint}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Быстрая замена лёгких файлов -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Quick_Title}" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Mono}" TextWrapping="Wrap" Text="{l:L Quick_Sub}" Margin="0,0,0,12"/>
        <StackPanel x:Name="QuickPanel"/>
        <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" TextWrapping="Wrap"
                   Text="{l:L Quick_Hint}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_Add}" Height="38" Padding="16,0" Click="AddButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Refresh}" Height="38" Padding="16,0" Margin="10,0,0,0" Click="RefreshButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Toggle}" Height="38" Padding="16,0" Margin="10,0,0,0" Click="ToggleButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Delete}" Height="38" Padding="16,0" Margin="10,0,0,0" Click="DeleteButton_Click"/>
    </StackPanel>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
      <ListView x:Name="ModsList" Height="280" Background="Transparent" BorderThickness="0"
                SelectionMode="Extended">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource DarkListRow}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Active}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource FgDimmerBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridHeader}">
            <GridViewColumn Header="{l:L Mods_ColFile}" Width="320" DisplayMemberBinding="{Binding Path}"/>
            <GridViewColumn Header="{l:L Col_Status}" Width="110" DisplayMemberBinding="{Binding Status}"/>
            <GridViewColumn Header="{l:L Col_Size}" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
            <GridViewColumn Header="{l:L Col_Author}" Width="120" DisplayMemberBinding="{Binding Author}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Mods_FleasionTitle}" Margin="0,0,0,8"/>
        <CheckBox x:Name="FleasionCheckBox" Style="{StaticResource Switch}">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}"
                       Text="{l:L Mods_FleasionRun}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Mods_FleasionDesc}"/>
          </StackPanel>
        </CheckBox>
        <TextBlock x:Name="FleasionStatus" Style="{StaticResource Mono}" Text="{l:L Common_StatusCheck}" Margin="0,10,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_Download}" Width="140" Height="36" Click="DownloadButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Folder}" Width="120" Height="36" Margin="10,0,0,0" Click="FolderButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" TextWrapping="Wrap"
               Text="{l:L Mods_Hint}"/>
  </StackPanel>
</UserControl>
