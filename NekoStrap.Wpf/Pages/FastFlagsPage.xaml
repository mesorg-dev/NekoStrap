<UserControl x:Class="NekoStrap.Wpf.Pages.FastFlagsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="FastFlags" Margin="0,0,0,6"/>
    <TextBlock Style="{StaticResource Body}" Text="Редактируй флаги клиента Roblox напрямую." Margin="0,0,0,10"/>

    <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
      <TextBox x:Name="SearchBox" Style="{StaticResource DarkInput}" Width="200" Height="38"
               VerticalContentAlignment="Center" Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"/>
      <Button Style="{StaticResource PrimaryButton}" Content="+  Флаг" Height="38" Padding="16,0" Margin="0,0,10,0" Click="AddButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Сохранить" Height="38" Padding="16,0" Margin="0,0,10,0" Click="SaveButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Импорт" Height="38" Padding="16,0" Margin="0,0,10,0" Click="ImportButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Экспорт" Height="38" Padding="16,0" Margin="0,0,10,0" Click="ExportButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Удалить" Height="38" Padding="16,0" Click="DeleteButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Удалить все" Height="38" Padding="16,0" Margin="10,0,0,0" Click="DeleteAllButton_Click"/>
    </WrapPanel>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
      <DataGrid x:Name="FlagsGrid" Style="{StaticResource DarkGrid}" Height="300"
                CellEditEnding="FlagsGrid_CellEditEnding" PreviewKeyDown="FlagsGrid_PreviewKeyDown">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Название флага" Binding="{Binding Name}" Width="*"
                              EditingElementStyle="{StaticResource DarkGridEdit}"/>
          <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="160"
                              EditingElementStyle="{StaticResource DarkGridEdit}"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource FgDimBrush}"
                   Text="Пресеты — нажми, чтобы добавить или убрать флаг" Margin="0,0,0,10"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120"
                      Style="{StaticResource DarkScrollViewer}">
          <WrapPanel x:Name="PresetsPanel"/>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource FgDimBrush}"
                   Text="Профили — целые наборы флагов в один клик" Margin="0,0,0,10"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="80"
                      Style="{StaticResource DarkScrollViewer}">
          <WrapPanel x:Name="ProfilesPanel"/>
        </ScrollViewer>
        <TextBlock x:Name="ProfilesEmpty" Style="{StaticResource Mono}" FontStyle="Italic"
                   Text="Пока пусто — собери флаги выше и сохрани как профиль." Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="ProfileNameBox" Style="{StaticResource DarkInput}" Width="200" Height="38"
                   VerticalContentAlignment="Center"/>
          <Button Style="{StaticResource PrimaryButton}" Content="Сохранить набор" Height="38" Padding="16,0" Margin="10,0,0,0" Click="ProfileSaveButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="Удалить" Height="38" Padding="16,0" Margin="10,0,0,0" Click="ProfileDeleteButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
