<UserControl x:Class="NekoStrap.Wpf.Controls.FeatureExpander"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glass="clr-namespace:NekoStrap.Wpf">
  <!-- Компактная фича: заголовок + тумблер + шестерёнка.
       Включил тумблер → под строкой выезжают опции (Content).
       Шестерёнка/клик по шапке сворачивает, не выключая. -->
  <Border x:Name="Root"
          BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1"
          CornerRadius="4" Background="{DynamicResource CardBrush}"
          Margin="0,0,0,6" Padding="10,0,10,0"
          glass:Glass.IsGlass="True" glass:Glass.CornerRadius="4">
    <StackPanel>
      <Grid x:Name="Head" Cursor="Hand" Margin="0,5,0,5" MouseLeftButtonUp="Head_MouseLeftButtonUp">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText"
                     FontFamily="{DynamicResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis"
                     Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          <TextBlock x:Name="HintText" Style="{StaticResource Mono}"
                     TextWrapping="Wrap" Margin="0,1,0,0" Visibility="Collapsed"
                     Text="{Binding Hint, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="GearText" Text="&#x2699;" FontSize="12"
                     Foreground="{DynamicResource FgDimmerBrush}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <CheckBox x:Name="Toggle" Style="{StaticResource Switch}" VerticalAlignment="Center"
                    Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
        </StackPanel>
      </Grid>
      <Border x:Name="OptsHost"
              BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineSoftBrush}"
              Background="{StaticResource LineSoftBrush}"
              Margin="-10,0,-10,0" Padding="10,5,10,8"
              Visibility="Collapsed">
        <ContentPresenter x:Name="OptsPresenter"/>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
