<Window x:Class="NekoStrap.Wpf.FlagConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NekoStrap.Wpf"
        Title="{l:L Dlg_FlagConflictTitle}" Width="460"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource BgBrush}">
  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <DockPanel LastChildFill="True">
      <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource ChromeBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseDown">
        <DockPanel LastChildFill="False">
          <TextBlock Text="{l:L Dlg_FlagConflictTitle}" FontFamily="{DynamicResource HeadingFont}" FontSize="13"
                     FontWeight="Bold" Foreground="{DynamicResource FgBrush}"
                     VerticalAlignment="Center" Margin="14,0,0,0"/>
          <Button Style="{StaticResource TitleBarButton}" Height="36" DockPanel.Dock="Right" Click="CloseButton_Click">
            <Path Data="M0,0L10,10 M10,0L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
          </Button>
        </DockPanel>
      </Border>

      <StackPanel Margin="16,14,16,16">
        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{l:L Dlg_FlagConflictQ}"/>
        <Border Background="{StaticResource LineSoftBrush}" Padding="10,8" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock x:Name="KeyText" Style="{StaticResource MonoBright}" FontSize="12.5"
                       FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="OldValueText" Style="{StaticResource Mono}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="NewValueText" Style="{StaticResource Mono}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Keep}" Width="130" Height="36"
                  Click="KeepButton_Click"/>
          <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_Replace}" Width="120" Height="36"
                  Margin="10,0,0,0" Click="ReplaceButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_ReplaceAll}" Width="140" Height="36"
                  Margin="10,0,0,0" Click="ReplaceAllButton_Click"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
