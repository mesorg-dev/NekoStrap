<Window x:Class="NekoStrap.Wpf.ColorTuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NekoStrap.Wpf"
        Title="{l:L Tune_Title}" Width="360" Height="500" MinWidth="360" MinHeight="500"
        MaxWidth="360" MaxHeight="500"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False" Background="{StaticResource BgBrush}">
  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <DockPanel LastChildFill="True">
      <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource ChromeBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseDown">
        <DockPanel LastChildFill="False">
          <TextBlock Text="{l:L Tune_Title}" FontFamily="{DynamicResource HeadingFont}" FontSize="13"
                     FontWeight="Bold" Foreground="{DynamicResource FgBrush}"
                     VerticalAlignment="Center" Margin="14,0,0,0"/>
          <Button Style="{StaticResource TitleBarButton}" Height="36" DockPanel.Dock="Right" Click="CloseButton_Click">
            <Path Data="M0,0L10,10 M10,0L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
          </Button>
        </DockPanel>
      </Border>

      <StackPanel Margin="16,8,16,12">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Body}" Text="{l:L Tune_Sat}"/>
          <TextBlock x:Name="SatValue" Style="{StaticResource MonoBright}" Margin="10,0,0,0" Text="1.00"/>
        </StackPanel>
        <Slider x:Name="SatBar" Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="200"
                SmallChange="10" LargeChange="20" ValueChanged="SatBar_Changed"/>

        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Body}" Text="{l:L Tune_Bri}"/>
          <TextBlock x:Name="BriValue" Style="{StaticResource MonoBright}" Margin="10,0,0,0" Text="+0.00"/>
        </StackPanel>
        <Slider x:Name="BriBar" Style="{StaticResource ThemedSlider}" Minimum="-50" Maximum="50"
                SmallChange="5" LargeChange="10" ValueChanged="BriBar_Changed"/>

        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Body}" Text="{l:L Tune_Con}"/>
          <TextBlock x:Name="ConValue" Style="{StaticResource MonoBright}" Margin="10,0,0,0" Text="1.00"/>
        </StackPanel>
        <Slider x:Name="ConBar" Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="200"
                SmallChange="10" LargeChange="20" ValueChanged="ConBar_Changed"/>

        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Body}" Text="{l:L Tune_Temp}"/>
          <TextBlock x:Name="TempValue" Style="{StaticResource MonoBright}" Margin="10,0,0,0" Text="+0.00"/>
        </StackPanel>
        <Slider x:Name="TempBar" Style="{StaticResource ThemedSlider}" Minimum="-100" Maximum="100"
                SmallChange="5" LargeChange="10" ValueChanged="TempBar_Changed"/>

        <WrapPanel Margin="0,6,0,0" x:Name="PresetsPanel">
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Tune_Standard}" Width="76" Height="30" Margin="0,0,6,0" Click="PresetStandard_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Tune_Cinema}" Width="76" Height="30" Margin="0,0,6,0" Click="PresetCinema_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Tune_Vivid}" Width="76" Height="30" Margin="0,0,6,0" Click="PresetVivid_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Tune_Mono}" Width="76" Height="30" Click="PresetMono_Click"/>
        </WrapPanel>

        <CheckBox x:Name="OnToggle" Style="{StaticResource Switch}" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Tune_On_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Tune_On_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="AutoToggle" Style="{StaticResource Switch}" Margin="0,6,0,0">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Tune_Auto_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Tune_Auto_D}"/>
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
