<Window x:Class="NekoStrap.Wpf.PerfOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NekoStrap.Wpf"
        Title="NekoStrap Perf" Width="190"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" SizeToContent="Height"
        Background="Transparent" AllowsTransparency="True">
  <!-- Оверлей производительности поверх игры: без фокуса (игра не теряет
       ввод), шапка перетаскивается зажатием, строки метрик скрываются
       конфигом. Размер по высоте — окно схлопывается, когда строк нет. -->
  <Border x:Name="Root" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
          CornerRadius="4" MouseLeftButtonDown="Root_MouseDown">
    <StackPanel>
      <DockPanel x:Name="Header" Height="24" Background="{StaticResource ChromeBrush}">
        <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}" DockPanel.Dock="Right"
                Click="CloseButton_Click" ToolTip="{l:L Perf_Close}">
          <Path Data="M0,0L10,10 M10,0L0,10"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Width="10" Height="10"/>
        </Button>
        <TextBlock x:Name="TitleLabel" Style="{StaticResource Mono}" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center"
                   Margin="9,0,0,0" Text="{l:L Perf_Header}"/>
      </DockPanel>
      <StackPanel x:Name="Rows" Margin="9,5,9,7"/>
    </StackPanel>
  </Border>
</Window>
