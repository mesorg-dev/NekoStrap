<UserControl x:Class="NekoStrap.Wpf.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glass="clr-namespace:NekoStrap.Wpf">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="Главная" Margin="0,0,0,6"/>
    <TextBlock Style="{StaticResource Body}" Text="Кастомный лаунчер Roblox — быстрый, лёгкий, стильный." Margin="0,0,0,10"/>

    <!-- Hero: запуск -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="Запуск игры" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock x:Name="StatusDot" Text="●" FontSize="9" Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusLabel" Style="{StaticResource Body}" Text="Готов к запуску" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="AccountLabel" Style="{StaticResource Mono}" Text="Аккаунт: —"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="Играть"
                Width="190" Height="48" FontSize="14" HorizontalAlignment="Left" Click="PlayButton_Click"/>
        <Border x:Name="ProgressTrack" Height="6" CornerRadius="2" Margin="0,12,0,0"
                Background="{StaticResource LineBrush}" Visibility="Collapsed">
          <Border x:Name="ProgressFill" CornerRadius="2" Background="{StaticResource FgBrush}"
                  HorizontalAlignment="Left" Width="0"/>
        </Border>
        <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,14,0,8"/>
        <TextBlock x:Name="VersionLabel" Style="{StaticResource Mono}"
                   Text="Лаунчер 1.0.0   •   Roblox: не определено" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>

    <!-- Статы: общий фон + зазоры 1px = тонкие разделители -->
    <Grid Background="{StaticResource LineSoftBrush}" Height="118" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="2" Padding="24,16" Margin="1"
              glass:Glass.IsGlass="True" glass:Glass.CornerRadius="2">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ModsValue" FontFamily="{StaticResource HeadingFont}" FontSize="26"
                     FontWeight="Bold" Foreground="{StaticResource FgBrush}" Text="0"/>
          <TextBlock Style="{StaticResource Mono}" Text="Модов установлено" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="2" Padding="24,16" Margin="0,1,1,1"
              glass:Glass.IsGlass="True" glass:Glass.CornerRadius="2">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="FlagsValue" FontFamily="{StaticResource HeadingFont}" FontSize="26"
                     FontWeight="Bold" Foreground="{StaticResource FgBrush}" Text="0"/>
          <TextBlock Style="{StaticResource Mono}" Text="FastFlags активно" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="2" Padding="24,16" Margin="0,1,1,1"
              glass:Glass.IsGlass="True" glass:Glass.CornerRadius="2">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="HoursValue" FontFamily="{StaticResource HeadingFont}" FontSize="20"
                     FontWeight="Bold" Foreground="{StaticResource FgBrush}" Text="0"/>
          <TextBlock Style="{StaticResource Mono}" Text="Часов в Roblox" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Избранное -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="Bold"
                   Foreground="{StaticResource FgDimBrush}" Text="Избранное" Margin="0,0,0,6"/>
        <TextBlock x:Name="FavoritesEmpty" Style="{StaticResource Mono}" FontStyle="Italic"
                   Text="Пока пусто — добавь из Истории кнопкой «★ В избранное»." Margin="0,0,0,2"/>
        <WrapPanel x:Name="FavoritesPanel"/>
      </StackPanel>
    </Border>

    <!-- Последняя игра -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="13" FontWeight="Bold"
                   Foreground="{StaticResource FgDimBrush}" Text="Последняя игра" Margin="0,0,0,6"/>
        <TextBlock x:Name="LastGameLabel" FontFamily="{StaticResource UiFont}" FontSize="15"
                   FontWeight="Bold" Foreground="{StaticResource FgBrush}" Text="—"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        <Button x:Name="AgainButton" Style="{StaticResource PrimaryButton}" Content="Играть снова"
                Width="170" Height="34" HorizontalAlignment="Left"
                Visibility="Collapsed" Click="AgainButton_Click"/>
      </StackPanel>
    </Border>

    <!-- Сервер -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="13" FontWeight="Bold"
                   Foreground="{StaticResource FgDimBrush}" Text="Сервер" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ServerIp" Grid.Column="0" Style="{StaticResource MonoBright}" FontSize="14" Text="—"/>
          <TextBlock x:Name="ServerGeo" Grid.Column="1" Style="{StaticResource MonoBright}" FontSize="14" Text="—"/>
          <TextBlock x:Name="ServerPing" Grid.Column="2" Style="{StaticResource MonoBright}" FontSize="14" Text="—"/>
        </Grid>
        <TextBlock Style="{StaticResource Mono}" Text="IP  •  город, страна  •  пинг — обновляется во время игры"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
