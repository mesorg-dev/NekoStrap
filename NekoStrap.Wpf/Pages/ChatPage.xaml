<UserControl x:Class="NekoStrap.Wpf.Pages.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NekoStrap.Wpf">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="{l:L Nav_Chat}" Margin="0,0,0,6"/>
    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{l:L Chat_Sub}" Margin="0,0,0,10"/>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <DockPanel LastChildFill="True">
        <!-- Статус + режим -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="OverlayButton" Style="{StaticResource OutlineButton}"
                    Content="{l:L Chat_Overlay}" Width="100" Height="30" Click="OverlayButton_Click"/>
            <Button x:Name="AllButton" Style="{StaticResource PrimaryButton}"
                    Content="{l:L Chat_All}" Width="90" Height="30" Margin="8,0,0,0" Click="AllButton_Click"/>
            <Button x:Name="DmButton" Style="{StaticResource OutlineButton}"
                    Content="{l:L Chat_Dm}" Width="70" Height="30" Margin="8,0,0,0" Click="DmButton_Click"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource FgDimmerBrush}"
                     VerticalAlignment="Center"/>
            <TextBlock x:Name="StateLabel" Style="{StaticResource Mono}" Text="{l:L Chat_Off}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button x:Name="RoomGlobalBtn" Style="{StaticResource PrimaryButton}"
                    Content="{l:L Chat_RoomGlobal}" Width="90" Height="30" Margin="16,0,0,0"
                    Click="RoomGlobalButton_Click"/>
            <Button x:Name="RoomServerBtn" Style="{StaticResource OutlineButton}"
                    Content="{l:L Chat_RoomServer}" Width="90" Height="30" Margin="8,0,0,0"
                    Click="RoomServerButton_Click"/>
          </StackPanel>
        </DockPanel>

        <!-- Контент: сообщения + игроки -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="190"/>
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource LineSoftBrush}" CornerRadius="2" Height="340">
              <Grid>
                <ListBox x:Name="MessagesList" Background="Transparent" BorderThickness="0"
                         BorderBrush="Transparent" Margin="10,8"
                         SelectionMode="Single" VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0,1,0,1"/>
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                              <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource LineSoftBrush}"/>
                              </Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource LineSoftBrush}"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                 FontFamily="{DynamicResource MonoFont}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Mine}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ChatEmpty" Style="{StaticResource Mono}" FontStyle="Italic"
                           Text="{l:L Empty_Chat}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280"
                           Visibility="Collapsed"/>
              </Grid>
            </Border>
            <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="True">
              <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_Send}" Width="100" Height="36"
                      DockPanel.Dock="Right" Margin="8,0,0,0" Click="SendButton_Click"/>
              <TextBox x:Name="InputBox" Style="{StaticResource DarkInput}" Height="36"
                       VerticalContentAlignment="Center" MaxLength="500"
                       KeyDown="InputBox_KeyDown"/>
            </DockPanel>
          </Grid>

          <Border Grid.Column="1" Background="{StaticResource LineSoftBrush}" CornerRadius="2">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Mono}" FontSize="11"
                         Text="{l:L Chat_Users}" Margin="10,8,10,4"/>
              <ListBox x:Name="UsersList" Background="Transparent" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       MouseDoubleClick="UsersList_DoubleClick"/>
            </DockPanel>
          </Border>
        </Grid>
      </DockPanel>
    </Border>

    <TextBlock x:Name="HintLabel" Style="{StaticResource Mono}" FontStyle="Italic"
               Foreground="{DynamicResource FgDimBrush}" TextWrapping="Wrap" Text="{l:L Chat_NotInGame}"/>

    <!-- Настройки чата: раньше жили в Настройках, теперь рядом с чатом -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Chat_SetTitle}" Margin="0,0,0,8"/>
        <CheckBox x:Name="ChatEnabledBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_Chat_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_Chat_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="ChatDmBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_ChatDm_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_ChatDm_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="ChatOverlayBox" Style="{StaticResource Switch}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_ChatOverlay_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_ChatOverlay_D}"/>
          </StackPanel>
        </CheckBox>
        <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_SaveSettings}"
                Width="220" Height="44" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveButton_Click"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
