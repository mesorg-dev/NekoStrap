<Window x:Class="NekoStrap.Wpf.ChatOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NekoStrap.Wpf"
        Title="NekoStrap Chat" Width="360" Height="480"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Transparent" AllowsTransparency="True">
  <!-- Летающий оверлей чата поверх игры: перетаскивается зажатием шапки,
       сворачивается в полоску, разворачивается обратно. -->
  <Border x:Name="Root" Background="#E60A0A0B" BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1" CornerRadius="3">
    <DockPanel LastChildFill="True">
      <!-- Шапка: перетаскивание зажатием -->
      <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource ChromeBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
              CornerRadius="3,3,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
        <DockPanel LastChildFill="False">
          <Button Style="{StaticResource TitleBarButton}" Height="36" DockPanel.Dock="Right"
                  Click="CloseButton_Click" ToolTip="{l:L Chat_Close}">
            <Path Data="M0,0L10,10 M10,0L0,10"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="10" Height="10"/>
          </Button>
          <Button Style="{StaticResource TitleBarButton}" Height="36" DockPanel.Dock="Right"
                  Click="MinButton_Click" ToolTip="{l:L Chat_Minimize}">
            <Path Data="M0,0H10"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="10" Height="10"/>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{StaticResource FgDimmerBrush}"
                     VerticalAlignment="Center"/>
            <TextBlock Text="{l:L Chat_OverlayTitle}" FontFamily="{DynamicResource HeadingFont}"
                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FgBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock x:Name="UsersLabel" Style="{StaticResource Mono}" FontSize="10"
                       Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center"
                       Margin="8,1,0,0" Text="0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Нижняя полоса: тоже за неё можно тащить зажатием.
           Дocks Bottom ДО Body: LastChildFill отдаёт остаток телу,
           иначе футер растягивается вправо и «в разработке» вылезает
           у правого края поверх ленты. -->
      <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Height="22" Background="{StaticResource ChromeBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
              CornerRadius="0,0,3,3" MouseLeftButtonDown="TitleBar_MouseDown">
        <TextBlock x:Name="HintLabel" Style="{StaticResource Mono}" FontSize="10"
                   Foreground="{DynamicResource FgDimmerBrush}" VerticalAlignment="Center"
                   Margin="10,0,0,0" Text="{l:L Chat_WipShort}"/>
      </Border>

      <!-- Тело: список + ввод (последний ребёнок → fill) -->
      <Grid x:Name="Body" Margin="0,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="MessagesScroll" Grid.Row="0" Style="{StaticResource DarkScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="10,8">
          <StackPanel x:Name="MessagesPanel"/>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="8,6,8,8" LastChildFill="True">
          <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_Send}" Width="90" Height="32"
                  DockPanel.Dock="Right" Margin="6,0,0,0" Click="SendButton_Click"/>
          <TextBox x:Name="InputBox" Style="{StaticResource DarkInput}" Height="32"
                   Background="#FF141417" Foreground="{DynamicResource FgBrush}"
                   CaretBrush="{DynamicResource FgBrush}" Padding="10,4"
                   VerticalContentAlignment="Center" MaxLength="500"
                   KeyDown="InputBox_KeyDown"/>
        </DockPanel>
      </Grid>
    </DockPanel>
  </Border>
</Window>
