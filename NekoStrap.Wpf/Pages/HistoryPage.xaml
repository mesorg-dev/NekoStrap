<UserControl x:Class="NekoStrap.Wpf.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="История" Margin="0,0,0,6"/>
    <TextBlock Style="{StaticResource Body}" Text="Где играл и сколько часов накатал." Margin="0,0,0,10"/>

    <WrapPanel Margin="0,0,0,12">
      <Button Style="{StaticResource PrimaryButton}" Content="Играть" Height="38" Padding="16,0" Margin="0,0,10,0" Click="PlayButton_Click"/>
      <Button x:Name="SortRecentButton" Style="{StaticResource PrimaryButton}" Content="Недавние" Height="38" Padding="16,0" Margin="0,0,10,0" Click="SortRecentButton_Click"/>
      <Button x:Name="SortTopButton" Style="{StaticResource OutlineButton}" Content="По времени" Height="38" Padding="16,0" Margin="0,0,10,0" Click="SortTopButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Удалить" Height="38" Padding="16,0" Margin="0,0,10,0" Click="DeleteButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Очистить" Height="38" Padding="16,0" Click="ClearButton_Click"/>
    </WrapPanel>

    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18">
      <ListView x:Name="HistoryList" Height="260" Background="Transparent" BorderThickness="0"
                SelectionMode="Single" ItemContainerStyle="{StaticResource DarkListRow}">
        <ListView.View>
          <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridHeader}">
            <GridViewColumn Header="Игра" Width="280" DisplayMemberBinding="{Binding Name}"/>
            <GridViewColumn Header="Наиграно" Width="120" DisplayMemberBinding="{Binding Played}"/>
            <GridViewColumn Header="Последний раз" Width="160" DisplayMemberBinding="{Binding Last}"/>
            <GridViewColumn Header="PlaceId" Width="120" DisplayMemberBinding="{Binding PlaceText}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" Margin="0,0,0,6"
               Text="Время пишется, пока игра запущена через лаунчер."/>

    <TextBlock FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="Bold"
               Foreground="{StaticResource FgBrush}" Margin="0,6,0,10"
               Text="Последние заходы — выбери и вернись на тот же сервер"/>

    <WrapPanel Margin="0,0,0,12">
      <Button Style="{StaticResource PrimaryButton}" Content="На тот же сервер" Height="38" Padding="16,0" Margin="0,0,10,0" Click="RejoinButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="На плейс" Height="38" Padding="16,0" Margin="0,0,10,0" Click="JoinButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Копия PlaceId" Height="38" Padding="16,0" Margin="0,0,10,0" Click="CopyPlaceButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Копия ссылки" Height="38" Padding="16,0" Margin="0,0,10,0" Click="CopyLinkButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="На сайте" Height="38" Padding="16,0" Margin="0,0,10,0" Click="SiteButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Удалить заход" Height="38" Padding="16,0" Margin="0,0,10,0" Click="DeleteSessionButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="Очистить" Height="38" Padding="16,0" Click="ClearSessionsButton_Click"/>
    </WrapPanel>

    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18">
      <ListView x:Name="SessionList" Height="300" Background="Transparent" BorderThickness="0"
                SelectionMode="Single" ItemContainerStyle="{StaticResource DarkListRow}"
                MouseDoubleClick="SessionList_DoubleClick">
        <ListView.View>
          <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridHeader}">
            <GridViewColumn Header="Игра" Width="210" DisplayMemberBinding="{Binding Game}"/>
            <GridViewColumn Header="PlaceId" Width="100" DisplayMemberBinding="{Binding PlaceText}"/>
            <GridViewColumn Header="Сервер (JobId)" Width="130" DisplayMemberBinding="{Binding Job}"/>
            <GridViewColumn Header="Заход" Width="130" DisplayMemberBinding="{Binding When}"/>
            <GridViewColumn Header="Был в игре" Width="100" DisplayMemberBinding="{Binding Duration}"/>
            <GridViewColumn Header="IP" Width="110" DisplayMemberBinding="{Binding Ip}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" TextWrapping="Wrap"
               Text="Двойной клик по заходу — перезайти на тот же сервер. Кнопка «На плейс» — на случайный сервер того же плейса."/>
  </StackPanel>
</UserControl>
