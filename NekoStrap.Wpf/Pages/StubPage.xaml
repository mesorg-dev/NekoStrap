<UserControl x:Class="NekoStrap.Wpf.Pages.StubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,6"/>
    <TextBlock x:Name="SubText" Style="{StaticResource Body}" Margin="0,0,0,10"/>
    <Border Style="{StaticResource Card}">
      <TextBlock Style="{StaticResource Mono}" Text="Страница переезжает с WinForms — скоро здесь будет настоящий контент." TextWrapping="Wrap"/>
    </Border>
  </StackPanel>
</UserControl>
