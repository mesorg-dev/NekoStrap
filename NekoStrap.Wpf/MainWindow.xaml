<Window x:Class="NekoStrap.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NekoStrap.Wpf"
        xmlns:glass="clr-namespace:NekoStrap.Wpf"
        Title="NekoStrap" Height="700" Width="1120" MinWidth="980" MinHeight="620"
        Icon="Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        PreviewKeyDown="Root_PreviewKeyDown">
  <WindowChrome.WindowChrome>
    <!-- Нативный хром: drag/даблклик/ресайз/снап работают сами.
         GlassFrameThickness снизу = DWM-тень без AllowsTransparency
         (с ним всё окно ушло бы в software-рендер). -->
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="7"
                  CornerRadius="0" GlassFrameThickness="0,0,0,1"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <!-- Обои: картинка + GPU-блюр + затемнение (всё на видеокарте) -->
    <Image x:Name="WallpaperImage" Stretch="UniformToFill" Visibility="Collapsed">
      <Image.Effect>
        <BlurEffect x:Name="WallpaperBlur" Radius="0" KernelType="Gaussian"/>
      </Image.Effect>
    </Image>
    <Rectangle x:Name="WallpaperOverlay" Fill="Black" Opacity="0.78" Visibility="Collapsed"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Тайтлбар -->
      <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource ChromeBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
              glass:Glass.IsGlass="True" glass:Glass.Tint="Chrome" glass:Glass.CornerRadius="0">
        <DockPanel LastChildFill="False">
          <TextBlock Text="NekoStrap" FontFamily="{DynamicResource HeadingFont}" FontSize="13"
                     FontWeight="Bold" Foreground="{DynamicResource FgBrush}"
                     VerticalAlignment="Center" Margin="18,0,0,0"/>
          <TextBlock x:Name="PageTitleLabel" Text="{l:L Nav_Home}"
                     FontFamily="{DynamicResource MonoFont}" FontSize="10"
                     Foreground="{DynamicResource FgDimmerBrush}"
                     VerticalAlignment="Center" Margin="10,2,0,0"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="MinButton" Style="{StaticResource TitleBarButton}"
                    ToolTip="{l:L Win_Min}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="MinButton_Click">
              <Path Data="M0,0H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
            </Button>
            <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}"
                    ToolTip="{l:L Win_Max}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxButton_Click">
              <Path x:Name="MaxIcon" Data="M0,0H10V10H0Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6" Width="10" Height="10"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}"
                    ToolTip="{l:L Win_Close}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click">
              <Path Data="M0,0L10,10 M10,0L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10"/>
            </Button>
          </StackPanel>
          <!-- Последний статус лаунчера: виден с любой страницы -->
          <TextBlock x:Name="GlobalStatusText" Text="" FontFamily="{DynamicResource MonoFont}" FontSize="10"
                     Foreground="{DynamicResource FgDimmerBrush}" VerticalAlignment="Center"
                     MaxWidth="360" TextTrimming="CharacterEllipsis" Margin="16,2,8,0"
                     Visibility="Collapsed"/>
        </DockPanel>
      </Border>
      <!-- Глобальный прогресс: установка/фоновое обновление видны с любой страницы -->
      <Border x:Name="GlobalProgress" Grid.Row="0" Grid.ColumnSpan="2" Height="2"
              VerticalAlignment="Bottom" Panel.ZIndex="60" Background="Transparent"
              IsHitTestVisible="False" Visibility="Collapsed">
        <Border x:Name="GlobalProgressFill" HorizontalAlignment="Left" Width="0"
                Background="{StaticResource FgBrush}"/>
      </Border>

      <!-- Сайдбар -->
      <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ChromeBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0"
              glass:Glass.IsGlass="True" glass:Glass.Tint="Chrome" glass:Glass.CornerRadius="0">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,0,0">
            <Border Width="34" Height="34" Background="{StaticResource FgBrush}" CornerRadius="2">
              <TextBlock Text="N" FontFamily="{DynamicResource HeadingFont}" FontSize="17" FontWeight="Bold"
                         Foreground="{StaticResource BgBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="NekoStrap" FontFamily="{DynamicResource HeadingFont}" FontSize="15.5"
                         FontWeight="Bold" Foreground="{DynamicResource FgBrush}"/>
              <TextBlock Text="R O B L O X" FontFamily="{DynamicResource MonoFont}" FontSize="9"
                         Foreground="{DynamicResource FgDimmerBrush}"/>
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
            <RadioButton x:Name="NavHome" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Tag="{StaticResource IconHome}" Content="{l:L Nav_Home}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavMods" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Tag="{StaticResource IconMods}" Content="{l:L Nav_Mods}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavFlags" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Tag="{StaticResource IconFlags}" Content="{l:L Nav_Flags}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavVersions" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Tag="{StaticResource IconVersions}" Content="{l:L Nav_Versions}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavHistory" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Tag="{StaticResource IconHistory}" Content="{l:L Nav_History}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavChat" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Tag="{StaticResource IconChat}" Content="{l:L Nav_Chat}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Tag="{StaticResource IconSettings}" Content="{l:L Nav_Settings}" Checked="Nav_Checked"/>
            <RadioButton x:Name="NavAbout" Style="{StaticResource NavRadio}" GroupName="Nav"
                         Tag="{StaticResource IconAbout}" Content="{l:L Nav_About}" Checked="Nav_Checked"/>
          </StackPanel>

          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                  Padding="20,14,0,14">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="●" FontSize="9" Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="FooterText" Style="{StaticResource Mono}" Text="{l:L Footer_ReadyInit}" Margin="8,0,0,0"/>
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <!-- Контент -->
      <ScrollViewer Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkScrollViewer}">
        <ContentControl x:Name="PageHost" Margin="32,26,32,32"/>
      </ScrollViewer>

      <!-- Тосты: сообщения поверх контента, без модалок -->
      <StackPanel x:Name="ToastHost" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                  Panel.ZIndex="200" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,54,14,0" IsHitTestVisible="False"/>

      <!-- Command Palette (Ctrl+K) -->
      <Border x:Name="PaletteHost" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
              Panel.ZIndex="300" Visibility="Collapsed"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="640"/>
            <Setter Property="MaxHeight" Value="420"/>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="{StaticResource LineSoftBrush}" CornerRadius="6,6,0,0" Padding="14,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="⌘K" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                         Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="PaletteSearchBox" Grid.Column="1" Style="{StaticResource DarkInput}"
                       Height="32" VerticalContentAlignment="Center" FontSize="14"
                       TextChanged="PaletteSearchBox_TextChanged"
                       KeyDown="PaletteSearchBox_KeyDown"/>
              <TextBlock Grid.Column="2" Style="{StaticResource Mono}" FontSize="10"
                         Foreground="{DynamicResource FgDimmerBrush}" VerticalAlignment="Center"
                         Margin="10,0,0,0" Text="{l:L Palette_Hint}"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewer}" MaxHeight="360">
            <StackPanel x:Name="PaletteResultsPanel" Margin="8"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
