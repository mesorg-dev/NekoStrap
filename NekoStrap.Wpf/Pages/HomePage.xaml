<UserControl x:Class="NekoStrap.Wpf.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NekoStrap.Wpf"
             xmlns:glass="clr-namespace:NekoStrap.Wpf">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="{l:L Nav_Home}" Margin="0,0,0,6"/>
    <TextBlock Style="{StaticResource Body}" Text="{l:L Home_Sub}" Margin="0,0,0,10"/>

    <!-- Hero: запуск -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="{l:L Home_LaunchTitle}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock x:Name="StatusDot" Text="●" FontSize="9" Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusLabel" Style="{StaticResource Body}" Text="{l:L Status_Ready}" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="AccountLabel" Style="{StaticResource Mono}" Text="{l:L Home_AccountInit}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="{l:L Btn_Play}"
                Width="190" Height="48" FontSize="14" HorizontalAlignment="Left" Click="PlayButton_Click"/>
        <Border x:Name="ProgressTrack" Height="6" CornerRadius="2" Margin="0,12,0,0"
                Background="{StaticResource LineBrush}" Visibility="Collapsed">
          <Border x:Name="ProgressFill" CornerRadius="2" Background="{StaticResource FgBrush}"
                  HorizontalAlignment="Left" Width="0"/>
        </Border>
        <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,14,0,8"/>
        <TextBlock x:Name="VersionLabel" Style="{StaticResource Mono}"
                   Text="{l:L Home_VersionInit}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>

    <!-- Статы: общий фон + зазоры 1px = тонкие разделители -->
    <Grid Background="{StaticResource LineSoftBrush}" Height="118" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="2" Padding="24,16" Margin="1"
              glass:Glass.IsGlass="True" glass:Glass.CornerRadius="2">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ModsValue" FontFamily="{DynamicResource HeadingFont}" FontSize="26"
                     FontWeight="Bold" Foreground="{DynamicResource FgBrush}" Text="0"/>
          <TextBlock Style="{StaticResource Mono}" Text="{l:L Stats_Mods}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="2" Padding="24,16" Margin="0,1,1,1"
              glass:Glass.IsGlass="True" glass:Glass.CornerRadius="2">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="FlagsValue" FontFamily="{DynamicResource HeadingFont}" FontSize="26"
                     FontWeight="Bold" Foreground="{DynamicResource FgBrush}" Text="0"/>
          <TextBlock Style="{StaticResource Mono}" Text="{l:L Stats_Flags}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="2" Padding="24,16" Margin="0,1,1,1"
              glass:Glass.IsGlass="True" glass:Glass.CornerRadius="2">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="HoursValue" FontFamily="{DynamicResource HeadingFont}" FontSize="20"
                     FontWeight="Bold" Foreground="{DynamicResource FgBrush}" Text="0"/>
          <TextBlock Style="{StaticResource Mono}" Text="{l:L Stats_Hours}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Избранное -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource FgDimBrush}" Text="{l:L Fav_Title}" Margin="0,0,0,6"/>
        <TextBlock x:Name="FavoritesEmpty" Style="{StaticResource Mono}" FontStyle="Italic"
                   Text="{l:L Fav_Empty}" Margin="0,0,0,2"/>
        <WrapPanel x:Name="FavoritesPanel"/>
      </StackPanel>
    </Border>

    <!-- Поиск игр (живой API) -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource FgDimBrush}" Text="{l:L Search_Title}" Margin="0,0,0,6"/>
        <DockPanel LastChildFill="True" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="{l:L Search_Btn}"
                  Width="110" Height="36" Margin="10,0,0,0" Click="SearchButton_Click"/>
          <TextBox x:Name="SearchBox" Style="{StaticResource DarkInput}" Height="36"
                   VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>
        </DockPanel>
        <TextBlock x:Name="SearchStatus" Style="{StaticResource Mono}" FontStyle="Italic"
                   Text="{l:L Search_Hint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <ListBox x:Name="SearchList" Background="Transparent" BorderThickness="0" MaxHeight="240"
                 Visibility="Collapsed" MouseDoubleClick="SearchList_DoubleClick">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListRow}">
              <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="2,5">
                <Image x:Name="HitIcon" Width="36" Height="36" Margin="0,0,10,0" Stretch="UniformToFill"
                       Source="{Binding Icon}"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource FgBrush}" Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Style="{StaticResource Mono}" FontSize="11.5" Text="{Binding Meta}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                  <Setter TargetName="HitIcon" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- Последняя игра -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock FontFamily="{DynamicResource HeadingFont}" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource FgDimBrush}" Text="{l:L Home_LastGame}" Margin="0,0,0,6"/>
        <TextBlock x:Name="LastGameLabel" FontFamily="{DynamicResource UiFont}" FontSize="15"
                   FontWeight="Bold" Foreground="{DynamicResource FgBrush}" Text="—"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button x:Name="AgainButton" Style="{StaticResource PrimaryButton}" Content="{l:L Btn_PlayAgain}"
                  Width="170" Height="34" Visibility="Collapsed" Click="AgainButton_Click"/>
          <Button x:Name="CleanButton" Style="{StaticResource OutlineButton}" Content="{l:L Btn_CleanPlay}"
                  Height="34" Padding="14,0" Margin="10,0,0,0" Visibility="Collapsed"
                  ToolTip="{l:L Btn_CleanPlayTip}" Click="CleanButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Сервер -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock FontFamily="{DynamicResource HeadingFont}" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource FgDimBrush}" Text="{l:L Home_Server}" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ServerIp" Grid.Column="0" Style="{StaticResource MonoBright}" FontSize="14" Text="—"/>
          <TextBlock x:Name="ServerGeo" Grid.Column="1" Style="{StaticResource MonoBright}" FontSize="14" Text="—"/>
          <TextBlock x:Name="ServerPing" Grid.Column="2" Style="{StaticResource MonoBright}" FontSize="14" Text="—"/>
        </Grid>
        <TextBlock Style="{StaticResource Mono}" Text="{l:L Home_ServerHint}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
