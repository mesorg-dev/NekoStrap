<UserControl x:Class="NekoStrap.Wpf.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glass="clr-namespace:NekoStrap.Wpf">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="О программе" Margin="0,0,0,6"/>
    <TextBlock Style="{StaticResource Body}" Text="Сторонний лаунчер для Roblox." Margin="0,0,0,10"/>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <Border Background="{StaticResource FgBrush}" CornerRadius="2" Padding="12,3"
                HorizontalAlignment="Left" Margin="0,0,0,8">
          <TextBlock Text="NEKO" FontFamily="{StaticResource HeadingFont}" FontSize="13" FontWeight="Bold"
                     Foreground="{StaticResource BgBrush}"/>
        </Border>
        <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="34" FontWeight="Bold"
                   Foreground="{StaticResource FgBrush}" Text="NekoStrap" Margin="0,0,0,6"/>
        <Border Background="{StaticResource LineSoftBrush}" CornerRadius="2" Padding="10,2"
                HorizontalAlignment="Left" Margin="0,0,0,10">
          <TextBlock x:Name="VersionPill" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                     Foreground="{StaticResource FgDimBrush}" Text="v1.0.0"/>
        </Border>
        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Лёгкий и быстрый кастомный лаунчер для Roblox с поддержкой модов, гибкой настройкой FastFlags и строгим чёрно-белым интерфейсом."/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <Button Style="{StaticResource PrimaryButton}" Content="GitHub" Width="140" Height="40" Click="GithubButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="Discord" Width="140" Height="40" Margin="10,0,0,0" Click="DiscordButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="Telegram" Width="140" Height="40" Margin="10,0,0,0" Click="TelegramButton_Click"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" Text="Сделано для Roblox-сообщества" Margin="0,0,0,2"/>
        <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" TextWrapping="Wrap"
                   Text="Установка, FastFlags, Discord, Fleasion и плеер — по мотивам Voidstrap (MIT)."/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="Обновления" Margin="0,0,0,6"/>
        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Mono}" TextWrapping="Wrap"
                   Text="Проверка при запуске. Релизы: github.com/mesorg-dev/NekoStrap" Margin="0,0,0,8"/>
        <TextBlock x:Name="ReleaseNotes" Style="{StaticResource Mono}" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource OutlineButton}" Content="Проверить обновления" Width="210" Height="38" Click="CheckUpdatesButton_Click"/>
          <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Content="Скачать и установить"
                  Width="210" Height="38" Margin="10,0,0,0" Visibility="Collapsed" Click="DownloadButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="2" Padding="24,14" Margin="0,0,1,0"
              glass:Glass.IsGlass="True" glass:Glass.CornerRadius="2">
        <StackPanel>
          <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource FgBrush}" Text=".NET 8"/>
          <TextBlock Style="{StaticResource Mono}" Text="WPF, один exe" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="2" Padding="24,14" Margin="0,0,1,0"
              glass:Glass.IsGlass="True" glass:Glass.CornerRadius="2">
        <StackPanel>
          <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource FgBrush}" Text="ЧБ тема"/>
          <TextBlock Style="{StaticResource Mono}" Text="Строгая палитра" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="2" Padding="24,14"
              glass:Glass.IsGlass="True" glass:Glass.CornerRadius="2">
        <StackPanel>
          <TextBlock FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource FgBrush}" Text="Open Source"/>
          <TextBlock Style="{StaticResource Mono}" Text="MIT лицензия" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
