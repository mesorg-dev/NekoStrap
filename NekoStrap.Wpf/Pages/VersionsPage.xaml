<UserControl x:Class="NekoStrap.Wpf.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NekoStrap.Wpf">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="{l:L Nav_Versions}" Margin="0,0,0,6"/>
    <TextBlock Style="{StaticResource Body}" Text="{l:L Ver_Sub}" Margin="0,0,0,10"/>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_Activate}" Width="150" Height="38" Click="ActivateButton_Click"/>
      <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Delete}" Width="130" Height="38" Margin="10,0,0,0" Click="DeleteButton_Click"/>
    </StackPanel>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
      <ListView x:Name="VersionsList" Height="220" Background="Transparent" BorderThickness="0"
                SelectionMode="Single">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource DarkListRow}">
            <Setter Property="Foreground" Value="{DynamicResource FgDimBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
          <GridView ColumnHeaderContainerStyle="{StaticResource DarkGridHeader}">
            <GridViewColumn Header="{l:L Ver_ColVer}" Width="240" DisplayMemberBinding="{Binding Guid}"/>
            <GridViewColumn Header="{l:L Col_Size}" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
            <GridViewColumn Header="{l:L Col_Status}" Width="160" DisplayMemberBinding="{Binding Status}"/>
            <GridViewColumn Header="Studio" Width="100" DisplayMemberBinding="{Binding Studio}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Ver_IntegrityTitle}" Margin="0,0,0,8"/>
        <TextBlock x:Name="IntegrityStatus" Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,0,0,8" Text="{l:L Ver_IntegrityHint}"/>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_CheckFiles}" Width="170" Height="38"
                  Click="CheckFilesButton_Click"/>
          <Button x:Name="RepairButton" Style="{StaticResource PrimaryButton}" Content="{l:L Btn_RepairFiles}"
                  Width="170" Height="38" Margin="10,0,0,0" IsEnabled="False" Click="RepairButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Ver_StudioTitle}" Margin="0,0,0,8"/>
        <TextBlock x:Name="StudioStatus" Style="{StaticResource Mono}" FontSize="12" Text="{l:L Ver_StudioNotSet}" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_Install}" Width="150" Height="38" Click="InstallButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Launch}" Width="150" Height="38" Margin="10,0,0,0" Click="LaunchButton_Click"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Mono}" Text="{l:L Ver_StudioHint}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
