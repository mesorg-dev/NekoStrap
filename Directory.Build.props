<Project>

  <!-- Единственный источник версии для всех проектов решения.

       AppUpdater.CurrentVersion читает версию СВОЕЙ сборки
       (NekoStrap.Core), а WPF-проект объявлял её отдельно — если
       цифры разошлись, лаунчер считал себя старее релиза и входил в
       бесконечное автообновление: скачать, поставить, перезапуститься,
       снова «доступна версия vX».

       CI передаёт /p:Version из тега — глобальное свойство
       перекрывает это значение, как и раньше. -->
  <PropertyGroup>
    <Version>1.3.4</Version>
  </PropertyGroup>

</Project>
