<UserControl x:Class="NekoStrap.Wpf.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NekoStrap.Wpf">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="{l:L Nav_Settings}" Margin="0,0,0,6"/>
    <TextBlock Style="{StaticResource Body}" Text="{l:L Set_Sub}" Margin="0,0,0,10"/>

    <!-- Основное -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <CheckBox x:Name="CloseOnLaunchBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_CloseOnLaunch_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_CloseOnLaunch_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="DiscordRpcBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="Discord Rich Presence"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_Discord_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="SoundsBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_Sounds_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_Sounds_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="AutoUpdateBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_AutoUpdate_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_AutoUpdate_D}"/>
          </StackPanel>
        </CheckBox>
        <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,8,0,8"/>
        <TextBlock Style="{StaticResource Body}" Text="{l:L Set_RobloxPath}" Margin="0,0,0,6"/>
        <DockPanel LastChildFill="True">
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Browse}" Width="110" Height="36"
                  DockPanel.Dock="Right" Margin="10,0,0,0" Click="BrowseButton_Click"/>
          <TextBox x:Name="PathBox" Style="{StaticResource DarkInput}" Height="36" VerticalContentAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Звуки интерфейса: свой wav + громкость на каждый -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Set_Sounds_L}" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{l:L Set_SoundsDesc}"/>
        <StackPanel x:Name="SoundsPanel"/>
      </StackPanel>
    </Border>

    <!-- Внешний вид: шрифты и цвета текста -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Set_AppearTitle}" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{l:L Set_AppearDesc}"/>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Body}" VerticalAlignment="Center" Text="{l:L Set_FontHeading}"/>
          <ComboBox x:Name="HeadingFontCombo" Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkCombo}" Margin="0,0,0,8" SelectionChanged="AppearanceControl_Changed"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Body}" VerticalAlignment="Center" Text="{l:L Set_FontBody}"/>
          <ComboBox x:Name="BodyFontCombo" Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkCombo}" Margin="0,0,0,8" SelectionChanged="AppearanceControl_Changed"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Body}" VerticalAlignment="Center" Text="{l:L Set_FontMono}"/>
          <ComboBox x:Name="MonoFontCombo" Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkCombo}" SelectionChanged="AppearanceControl_Changed"/>
        </Grid>
        <StackPanel x:Name="ColorsPanel"/>
        <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_ResetTheme}" Width="210" Height="36"
                HorizontalAlignment="Left" Margin="0,4,0,0" Click="AppearanceResetButton_Click"/>
      </StackPanel>
    </Border>

    <!-- Язык -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Set_LangTitle}" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{l:L Set_LangDesc}"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="LangAutoButton" Style="{StaticResource PrimaryButton}" Content="{l:L Btn_LangAuto}" Width="120" Height="34" Click="LangAutoButton_Click"/>
          <Button x:Name="LangRuButton" Style="{StaticResource OutlineButton}" Content="Русский" Width="120" Height="34" Margin="10,0,0,0" Click="LangRuButton_Click"/>
          <Button x:Name="LangEnButton" Style="{StaticResource OutlineButton}" Content="English" Width="120" Height="34" Margin="10,0,0,0" Click="LangEnButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- FPS, Discord, трей -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <CheckBox x:Name="FpsBox2" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_Fps_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_Fps_D}"/>
          </StackPanel>
        </CheckBox>
        <TextBox x:Name="FpsValueBox" Style="{StaticResource DarkInput}" Width="100" Height="34"
                 VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,8"/>
        <TextBlock Style="{StaticResource Body}" Text="Discord Application ID (discord.com/developers → New Application)" Margin="0,0,0,6"/>
        <TextBox x:Name="DiscordAppBox" Style="{StaticResource DarkInput}" Height="34"
                 VerticalContentAlignment="Center" Margin="0,0,0,8"/>
        <CheckBox x:Name="MinimizeToTrayBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_MinTray_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_MinTray_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="CloseToTrayBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_CloseTray_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_CloseTray_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="NotificationsBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_Notify_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_Notify_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="RobloxNoTrayBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_NoTray_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_NoTray_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="RobloxNoStartupBox" Style="{StaticResource Switch}">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_NoStartup_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_NoStartup_D}"/>
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </Border>

    <!-- Счётчик времени -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <CheckBox x:Name="TrackPlaytimeBox" Style="{StaticResource Switch}">
        <StackPanel>
          <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_Playtime_L}"/>
          <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_Playtime_D}"/>
        </StackPanel>
      </CheckBox>
    </Border>

    <!-- CDN -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Set_CdnTitle}" Margin="0,0,0,6"/>
        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{l:L Set_CdnDesc}"/>
        <TextBlock x:Name="CdnStatus" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                   Foreground="{DynamicResource FgDimBrush}" Text="{l:L Common_StatusCheck}" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_CdnOn}" Width="170" Height="38" Click="CdnOnButton_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_CdnOff}" Width="150" Height="38" Margin="10,0,0,0" Click="CdnOffButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Обои -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Set_WallTitle}" Margin="0,0,0,8"/>
        <DockPanel LastChildFill="True" Margin="0,0,0,8">
          <Grid Width="160" Height="90" DockPanel.Dock="Left" Margin="0,0,12,0">
            <Image x:Name="WallpaperImage" Stretch="UniformToFill"/>
            <Border Background="{StaticResource LineSoftBrush}" Visibility="Collapsed" x:Name="WallpaperFallbackBg">
              <TextBlock Text="{l:L Set_WallNone}" FontFamily="{DynamicResource MonoFont}" FontSize="12" FontWeight="Bold"
                         Foreground="{DynamicResource FgDimmerBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <StackPanel VerticalAlignment="Top">
            <TextBlock x:Name="WallpaperPathLabel" Style="{StaticResource Mono}"
                       Text="{l:L Set_WallEmpty}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_PickFile}" Width="150" Height="36" Click="WallpaperPickButton_Click"/>
              <Button Style="{StaticResource OutlineButton}" Content="{l:L Btn_Reset}" Width="130" Height="36" Margin="10,0,0,0" Click="WallpaperResetButton_Click"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <TextBlock Style="{StaticResource Body}" Text="{l:L Set_Blur}" Margin="0,0,10,0"/>
          <TextBlock x:Name="WallpaperBlurValue" Style="{StaticResource MonoBright}" Text="0%"/>
        </StackPanel>
        <Slider x:Name="WallpaperBlurBar" Style="{StaticResource ThemedSlider}" ValueChanged="WallpaperBlurBar_Changed"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
          <TextBlock Style="{StaticResource Body}" Text="{l:L Set_Dim}" Margin="0,0,10,0"/>
          <TextBlock x:Name="WallpaperDimValue" Style="{StaticResource MonoBright}" Text="78%"/>
        </StackPanel>
        <Slider x:Name="WallpaperDimBar" Style="{StaticResource ThemedSlider}" Value="78" ValueChanged="WallpaperDimBar_Changed"/>
        <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="{l:L Set_WallNote}"/>
      </StackPanel>
    </Border>

    <!-- Стекло -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Set_GlassTitle}" Margin="0,0,0,8"/>
        <CheckBox x:Name="GlassCheckBox" Style="{StaticResource Switch}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{StaticResource FgBrush}" Text="{l:L Set_Glass_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_Glass_D}"/>
          </StackPanel>
        </CheckBox>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="GlassTintedButton" Style="{StaticResource PrimaryButton}" Content="{l:L Btn_GlassTinted}" Width="150" Height="34" Click="GlassTintedButton_Click"/>
          <Button x:Name="GlassClearButton" Style="{StaticResource OutlineButton}" Content="{l:L Btn_GlassClear}" Width="150" Height="34" Margin="10,0,0,0" Click="GlassClearButton_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <TextBlock Style="{StaticResource Body}" Text="{l:L Set_Opacity}" Margin="0,0,10,0"/>
          <TextBlock x:Name="GlassOpacityValue" Style="{StaticResource MonoBright}" Text="85%"/>
        </StackPanel>
        <Slider x:Name="GlassOpacityBar" Style="{StaticResource ThemedSlider}" Value="85" ValueChanged="GlassOpacityBar_Changed"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
          <TextBlock Style="{StaticResource Body}" Text="{l:L Set_GlassDim}" Margin="0,0,10,0"/>
          <TextBlock x:Name="GlassDimValue" Style="{StaticResource MonoBright}" Text="100%"/>
        </StackPanel>
        <Slider x:Name="GlassDimBar" Style="{StaticResource ThemedSlider}" Value="100" ValueChanged="GlassDimBar_Changed"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
          <TextBlock Style="{StaticResource Body}" Text="{l:L Set_GlassBlur}" Margin="0,0,10,0"/>
          <TextBlock x:Name="GlassBlurValue" Style="{StaticResource MonoBright}" Text="50%"/>
        </StackPanel>
        <Slider x:Name="GlassBlurBar" Style="{StaticResource ThemedSlider}" Value="50" ValueChanged="GlassBlurBar_Changed"/>
        <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="{l:L Set_GlassNote}"/>
      </StackPanel>
    </Border>

    <!-- Чат лаунчера (бета) -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource H2}" FontSize="13" Text="{l:L Set_ChatTitle}" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="{l:L Set_ChatDesc}"/>
        <TextBlock Style="{StaticResource Mono}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource FgDimBrush}" Text="{l:L Set_ChatWip}"/>
        <CheckBox x:Name="ChatEnabledBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_Chat_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_Chat_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="ChatDmBox" Style="{StaticResource Switch}" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_ChatDm_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_ChatDm_D}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="ChatOverlayBox" Style="{StaticResource Switch}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12.5" Foreground="{DynamicResource FgBrush}" Text="{l:L Set_ChatOverlay_L}"/>
            <TextBlock Style="{StaticResource Mono}" Text="{l:L Set_ChatOverlay_D}"/>
          </StackPanel>
        </CheckBox>
        <TextBlock Style="{StaticResource Body}" Text="{l:L Set_ChatUrl}" Margin="0,0,0,6"/>
        <TextBox x:Name="ChatUrlBox" Style="{StaticResource DarkInput}" Height="34"
                 VerticalContentAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock Style="{StaticResource Body}" Text="{l:L Set_ChatNick}" Margin="0,0,0,6"/>
        <TextBox x:Name="ChatNickBox" Style="{StaticResource DarkInput}" Height="34" MaxLength="32"
                 VerticalContentAlignment="Center"/>
      </StackPanel>
    </Border>

    <Button Style="{StaticResource PrimaryButton}" Content="{l:L Btn_SaveSettings}"
            Width="220" Height="44" HorizontalAlignment="Left" Click="SaveButton_Click"/>
  </StackPanel>
</UserControl>
